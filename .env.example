# Anthropic API key used by the classification/extraction stages (Claude vision + structured output)
ANTHROPIC_API_KEY=sk-ant-...

# Models used for classification and extraction (both default to claude-opus-5)
# CLASSIFICATION_MODEL=claude-opus-5
# EXTRACTION_MODEL=claude-opus-5

# Postgres connection used as the system-of-record store
# Port 5433 (not 5432) - matches docker-compose.yml, chosen to avoid colliding
# with any other local Postgres already using the default port.
DATABASE_URL=postgresql+psycopg://invoice_pipeline:invoice_pipeline@localhost:5433/invoice_pipeline

# Confidence threshold below which a field is routed to human review (0-1)
CONFIDENCE_THRESHOLD=0.75
