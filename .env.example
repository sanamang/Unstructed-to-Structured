# Anthropic API key used by the extraction stage (Claude vision + structured output)
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection used as the system-of-record store
DATABASE_URL=postgresql+psycopg://invoice_pipeline:invoice_pipeline@localhost:5432/invoice_pipeline

# Confidence threshold below which a field is routed to human review (0-1)
CONFIDENCE_THRESHOLD=0.75
